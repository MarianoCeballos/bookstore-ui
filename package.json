{
  "name": "bookstore-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "yarn api:generate && vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "api:generate": "node scripts/generate-api-types.mjs",
    "sanitycheck": "yarn typecheck && yarn lint && yarn test && yarn build",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.104.1",
    "axios": "1.20.0",
    "i18next": "26.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-is": "19.2.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.3.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "16.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.7.4",
    "sass": "1.105.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,json,md,scss,yml,yaml}": "prettier --write"
  }
}
